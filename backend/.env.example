# Database
DATABASE_URL=mysql://root:@localhost:3306/auth_modules

# Server
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# JWT Configuration (RS256)
# Generate keys using: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_ISSUER=https://auth-modules.com
JWT_EXPIRES_IN=3600

# Paste your PEM keys below (replace newlines with \n)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"